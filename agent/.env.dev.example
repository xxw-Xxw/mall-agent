# ============================================================
# Agent 开发环境配置：复制为 agent/.env.dev（已 gitignore）
# 启动时设置 APP_ENV=dev（默认），即加载本文件
# ============================================================

# 智谱 AI（去 https://open.bigmodel.cn 注册获取）
ZHIPU_API_KEY=your_api_key_here
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# LLM 配置
LLM_MODEL=glm-4-flash
LLM_TEMPERATURE=0.6
EMBEDDING_MODEL=embedding-3

# 商城后端 API 地址
RUOYI_BASE_URL=http://localhost:8080

# ChromaDB 向量库地址
CHROMA_BASE_URL=http://localhost:8000

# 向量集合名称
COLLECTION_NAME=mall_goods

# 允许跨域的前端地址，多个用英文逗号分隔
CORS_ORIGINS=http://localhost:3000

# 日志级别：DEBUG / INFO / WARNING
LOG_LEVEL=INFO

# 定时对账：每天 RECONCILE_HOUR 点核对商品与向量库
RECONCILE_ENABLED=true
RECONCILE_HOUR=3

# 混合检索：向量 + BM25 召回后 rerank 重排
RERANK_ENABLED=true
RERANK_MODEL=rerank

# 管理接口 JWT 签名密钥：后端按用户签发 JWT（HS256），Agent 验签 + 到 Redis 校验会话
# 需与后端 AGENT_JWT_SECRET 保持一致
AGENT_JWT_SECRET=
# JWT 会话有效期（分钟）
AGENT_JWT_EXPIRE_MINUTES=10

# Redis（存放按用户签发的 JWT 会话，key: agent:session:{jti}；以及商城会员 token）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# 会话状态持久化：一期为本地 SQLite 文件，重启后上下文不丢
CHECKPOINT_BACKEND=sqlite
CHECKPOINT_DB_PATH=agent/data/sessions.db
# 中期记忆压缩：未摘要内容超过该字符数时生成摘要，摘要后保留最近 N 条原文
SUMMARY_TRIGGER_CHARS=8000
SUMMARY_KEEP=8
SUMMARY_BATCH=20
