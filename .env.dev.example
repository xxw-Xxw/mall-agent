# ============================================================
# 后端开发环境配置：复制为根目录 .env.dev（已 gitignore）
# start-all.bat 启动时会自动加载
# ============================================================
SPRING_PROFILES_ACTIVE=dev

# 服务端口
SERVER_PORT=8080
# 上传文件目录（Windows 示例 D:/ruoyi/uploadPath，Linux 示例 /home/ruoyi/uploadPath）
RUOYI_PROFILE=D:/ruoyi/uploadPath
LOG_LEVEL=debug

# MySQL
DB_URL=jdbc:mysql://localhost:3306/ry-vue?useUnicode=true&characterEncoding=utf8&zeroDateTimeBehavior=convertToNull&useSSL=true&serverTimezone=Asia/Shanghai
DB_USERNAME=root
DB_PASSWORD=

# Druid 监控台账号
DRUID_USERNAME=ruoyi
DRUID_PASSWORD=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=

# JWT 令牌密钥（本地开发用）
TOKEN_SECRET=

# AI 导购服务地址
AGENT_BASE_URL=http://127.0.0.1:8090

# Agent 管理接口 JWT 签名密钥（生成：openssl rand -hex 64），后端与 Agent 必须一致
AGENT_JWT_SECRET=
# JWT 会话有效期（分钟）
AGENT_JWT_EXPIRE_MINUTES=10
