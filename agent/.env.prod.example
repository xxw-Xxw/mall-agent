# ============================================================
# Agent 生产环境配置：复制为 agent/.env.prod，或由部署平台以环境变量注入
# 启动前设置 APP_ENV=prod；缺少 ZHIPU_API_KEY 会拒绝启动
# ============================================================

# 必填：智谱 AI Key
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

LLM_MODEL=glm-4-flash
LLM_TEMPERATURE=0.3
EMBEDDING_MODEL=embedding-3

# 必填：内网后端地址
RUOYI_BASE_URL=http://127.0.0.1:8080

# 必填：向量库地址
CHROMA_BASE_URL=http://127.0.0.1:8000
COLLECTION_NAME=mall_goods

# 必填：实际站点域名，多个用英文逗号分隔，不要使用 *
CORS_ORIGINS=https://mall.example.com

LOG_LEVEL=INFO

RECONCILE_ENABLED=true
RECONCILE_HOUR=3

RERANK_ENABLED=true
RERANK_MODEL=rerank

# 必填：管理接口 JWT 签名密钥（至少 64 位随机串，需与后端 AGENT_JWT_SECRET 一致）
AGENT_JWT_SECRET=
AGENT_JWT_EXPIRE_MINUTES=10

# 必填：Redis（存放按用户签发的 JWT 会话）
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
