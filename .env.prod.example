# ============================================================
# 生产环境配置模板：不要复制进仓库，由部署平台的环境变量 / 密钥管理注入
# 启动：SPRING_PROFILES_ACTIVE=prod java -jar backend/ruoyi-admin.jar
# 以下变量全部为必填，缺失会直接启动失败
# ============================================================
SPRING_PROFILES_ACTIVE=prod

SERVER_PORT=8080
# Linux 示例：/home/ruoyi/uploadPath
RUOYI_PROFILE=
LOG_LEVEL=info

# MySQL（生产库地址，不要使用 root 账号，按最小权限单独建库账号）
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# Redis（生产 Redis 地址，建议开启密码）
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT 令牌密钥：使用至少 64 位的随机串
TOKEN_SECRET=

# AI 导购服务地址（内网地址）
AGENT_BASE_URL=http://127.0.0.1:8090

# 必填：Agent 管理接口 JWT 签名密钥（至少 64 位随机串，后端与 Agent 必须一致）
AGENT_JWT_SECRET=
AGENT_JWT_EXPIRE_MINUTES=10
